MYSQL_DATABASE=jxh_bot
MYSQL_USER=jxh
MYSQL_PASSWORD=jxh_password
MYSQL_ROOT_PASSWORD=root_password

NAPCAT_UID=1000
NAPCAT_GID=1000

# Bot container user - match host user for NAS (Synology/QNAP) permissions
# On Synology: check "File Station -> right click your share -> Properties -> Advanced" or `id yourusername`
PUID=10001
PGID=10001

QQ_QUOTE_REF=main

# Bot health check port inside the bot container. It is not published to the host.
HEALTH_PORT=8080

# Browser-facing manager port published by the frontend container.
WEB_PORT=8080

# Generate a unique value with at least 32 random bytes before starting bot.
JXH_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Optional comma-separated CIDRs for explicitly trusted reverse proxies.
JXH_ADMIN_TRUSTED_PROXIES=

JXH_ONEBOT_TOKEN=change-me

JXH_WPS_SHARE_URL=
JXH_WPS_SID=

# 同一套模型配置用于 /ai 和群申请字段提取；无“答案”标记时会发送完整验证信息。
JXH_AI_PROVIDER=openai
JXH_AI_BASE_URL=
JXH_AI_API_KEY=
JXH_AI_MODEL=
